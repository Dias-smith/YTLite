    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Mixtube الشبكة المحلية لتتمكن من استيراد الموسيقى من جهاز كمبيوتر على شبكة Wi‑Fi نفسها."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mixtube uses the local network so you can import music from a computer on the same Wi‑Fi."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mixtube usa la red local para que puedas importar música desde un ordenador en la misma red Wi‑Fi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Mixtube usa a rede local para você importar músicas de um computador na mesma rede Wi‑Fi."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo Library Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج Mixtube إلى الوصول إلى الصور لاستيراد الفيديو والصوت من ألبومك."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mixtube needs photo library access to import videos and audio from your album."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mixtube necesita acceso a Fotos para importar vídeos y audio de tu álbum."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Mixtube precisa acessar as Fotos para importar vídeos e áudio do seu álbum."
          }
        }
      }
    },
    "NSUserTrackingUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُستخدم هذا المعرّف لعرض إعلانات مخصصة وقياس أداء الإعلانات."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This identifier is used to deliver personalized ads and measure ad performance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este identificador se usa para mostrar anuncios personalizados y medir su rendimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet identifiant sert à diffuser des publicités personnalisées et à mesurer leurs performances."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह पहचानकर्ता व्यक्तिगत विज्ञापन दिखाने और विज्ञापन प्रदर्शन मापने के लिए उपयोग होती है।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este identificador é usado para exibir anúncios personalizados e medir o desempenho dos anúncios."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此标识符用于投放个性化广告并衡量广告效果。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此識別碼用於投放個人化廣告並衡量廣告成效。"
          }
        }
      }
    }
  },
  "version" : "1.0"
