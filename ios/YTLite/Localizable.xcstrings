    "player.sign_in_to_play_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج هذا الفيديو إلى حساب Google. تسجيل الدخول يفتح أيضًا مزامنة الاشتراكات والمكتبة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This video needs a Google account. Signing in also unlocks Subs and Library sync."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este vídeo necesita una cuenta de Google. Al iniciar sesión también se desbloquea la sincronización de suscripciones y de la biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette vidéo nécessite un compte Google. La connexion débloque aussi la synchro des abonnements et de la bibliothèque."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस वीडियो के लिए Google खाता चाहिए। साइन इन करने पर सब्सक्रिप्शन और लाइब्रेरी भी सिंक होते हैं।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este vídeo precisa de uma conta Google. Ao entrar, a sincronização de inscrições e da biblioteca também é liberada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此视频需要 Google 账号。登录后还可同步订阅与媒体库。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此影片需要 Google 帳號。登入後還可同步訂閱與媒體庫。"
          }
        }
      }
    },
