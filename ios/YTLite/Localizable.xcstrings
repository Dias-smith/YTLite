    "account.delete_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤدي هذا إلى حذف حساب Mixtube وبيانات المكتبة السحابية (قوائم التشغيل والسجل والاشتراكات والبيانات الوصفية) نهائيًا. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This permanently deletes your Mixtube account and cloud library data (playlists, history, subscriptions, and metadata). This can't be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina de forma permanente tu cuenta de Mixtube y los datos de la biblioteca en la nube (listas, historial, suscripciones y metadatos). No se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprime définitivement votre compte Mixtube et les données cloud de la bibliothèque (playlists, historique, abonnements et métadonnées). Cette action est irréversible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इससे आपका Mixtube खाता और क्लाउड लाइब्रेरी डेटा (प्लेलिस्ट, इतिहास, सब्सक्रिप्शन और मेटाडेटा) स्थायी रूप से हट जाएगा। इसे वापस नहीं किया जा सकता।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso exclui permanentemente sua conta Mixtube e os dados da biblioteca na nuvem (playlists, histórico, inscrições e metadados). Não é possível desfazer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将永久删除你的 Mixtube 账号以及云端媒体库数据（播放列表、历史记录、订阅和元数据）。此操作无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會永久刪除你的 Mixtube 帳號以及雲端媒體庫資料（播放清單、歷史記錄、訂閱和中繼資料）。此操作無法復原。"
          }
        }
      }
    },
