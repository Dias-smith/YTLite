    "import.wifi.no_wifi_ip" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يتم العثور على عنوان Wi-Fi. صِل هذا الـ iPhone بشبكة Wi-Fi، واسمح بالوصول إلى الشبكة المحلية، ثم أعد المحاولة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No Wi‑Fi address found. Connect this iPhone to Wi‑Fi, allow Local Network access, then retry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se encontró una dirección Wi-Fi. Conecta este iPhone a una red Wi-Fi, permite el acceso a la red local y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
