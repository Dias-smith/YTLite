    "feature_intro.sync.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجّل الدخول مرة واحدة، وتبقى مكتبتك آمنة ومحدّثة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in once—your library stays safe and up to date."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión una vez: tu biblioteca se mantiene a salvo y al día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous une fois : votre bibliothèque reste à jour sur tous vos appareils."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक बार साइन इन करें, प्लेलिस्ट अपने आप सिंक होती है और डिवाइस बदलने पर भी गाने रह जाते हैं।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entre uma vez: sua biblioteca fica segura e atualizada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登录后歌单自动同步，换设备也不丢歌。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登入後歌單自動同步，換設備也不丟歌。"
          }
        }
      }
    },
