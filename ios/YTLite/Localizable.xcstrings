    "feature_intro.watch_widget.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحكم في التشغيل من شاشة القفل أو الشاشة الرئيسية أو معصمك، دون فتح قفل الـ iPhone."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Control playback from your Lock Screen, Home Screen, or wrist—without unlocking your phone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controla la reproducción desde la pantalla de bloqueo, la pantalla de inicio o la muñeca, sin desbloquear el iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contrôlez la lecture depuis l’écran verrouillé, l’écran d’accueil ou la montre, sans déverrouiller le téléphone."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लॉक स्क्रीन, होम स्क्रीन या घड़ी से प्लेबैक नियंत्रित करें, फ़ोन खोले बिना।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controle a reprodução pela Tela Bloqueada, pela Tela de Início ou pelo pulso, sem desbloquear o iPhone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "锁屏、主屏幕或手腕上即可控制播放，无需打开手机。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鎖屏、主屏幕或手腕上即可控制播放，無需打開手機。"
          }
        }
      }
    },
