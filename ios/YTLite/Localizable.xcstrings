    "vip.section_footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل VIP الإعلانات أثناء التشغيل ويفتح السمات المميزة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VIP removes ads from playback and unlocks premium themes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "VIP quita los anuncios de la reproducción y desbloquea temas premium."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "VIP supprime les publicités pendant la lecture et débloque les thèmes premium."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "VIP प्लेबैक से विज्ञापन हटाता है और प्रीमियम थीम अनलॉक करता है।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O VIP remove anúncios da reprodução e desbloqueia temas premium."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开通会员可去除播放广告，并解锁高级主题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開通會員可去除播放廣告，並解鎖進階主題。"
          }
        }
      }
    },
    "vip.status": {
