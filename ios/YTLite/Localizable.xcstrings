    "import.wifi.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "على جهاز كمبيوتر في شبكة Wi-Fi نفسها، افتح العنوان أدناه (أو امسح رمز QR). اسمح بالوصول إلى الشبكة المحلية عندما يطلب iOS ذلك."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On a computer on the same Wi‑Fi, open the address below (or scan the QR). Allow Local Network when iOS asks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En un ordenador con la misma red Wi-Fi, abre la dirección de abajo (o escanea el QR). Permite el acceso a la red local cuando iOS lo pida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur un ordinateur connecté au même Wi‑Fi, ouvrez l’adresse ci-dessous (ou scannez le QR). Autorisez le réseau local si iOS le demande."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उसी Wi‑Fi के कंप्यूटर पर नीचे दिया पता खोलें (या QR स्कैन करें)। यदि सिस्टम लोकल नेटवर्क की अनुमति माँगे, तो अनुमति दें।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em um computador na mesma rede Wi-Fi, abra o endereço abaixo (ou escaneie o QR). Permita o acesso à Rede Local quando o iOS pedir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在同一 Wi‑Fi 的电脑上打开下方地址（或扫码）。若系统询问本地网络权限，请点允许。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在同一 Wi‑Fi 的電腦上打開下方地址（或掃碼）。若系統詢問區域網路權限，請點允許。"
          }
        }
      }
    },
