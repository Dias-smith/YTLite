    "import.gdrive.files_guide.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيفتح منتقي الملفات. اختر «استعراض» ثم Google Drive. إذا لم يظهر، ثبّت تطبيق Google Drive وفعّله من تعديل المواقع."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Files will open next. Tap Browse, then Google Drive. If it’s missing, install the Google Drive app and enable it under Browse → Edit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A continuación se abrirá Archivos. Pulsa Explorar y luego Google Drive. Si no aparece, instala la app Google Drive y actívala en Explorar → Editar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fichiers s’ouvrira ensuite. Touchez Parcourir, puis Google Drive. S’il manque, installez l’app Google Drive et activez-la via Parcourir → Modifier."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगले में Files खुलेगा। Browse टैप करें, फिर Google Drive। न दिखे तो Google Drive ऐप इंस्टॉल करें और Browse → Edit में चालू करें।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app Arquivos abrirá em seguida. Toque em Explorar e depois em Google Drive. Se não aparecer, instale o app Google Drive e ative em Explorar → Editar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接下来会打开「文件」。请点「浏览」，再选 Google Drive。若没有该项：先安装 Google Drive App，再在「浏览 → 编辑」里打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接下來會開啟「檔案」。請點「瀏覽」，再選 Google Drive。若沒有該項：先安裝 Google Drive App，再在「瀏覽 → 編輯」裡開啟。"
          }
        }
      }
    },
