    "you.apple_needs_google_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الاشتراكات والفيديوهات التي أعجبت بها تأتي من حسابك. سجّل الدخول باستخدام Google لتحميل هذا التبويب. تبقى مكتبة تسجيل الدخول عبر Apple منفصلة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subscriptions and Liked videos come from your Account account. Sign in with Google to load this tab. Your Apple-signed-in library stays separate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las suscripciones y los vídeos que te gustan vienen de tu cuenta. Inicia sesión con Google para cargar esta pestaña. La biblioteca con la que entraste mediante Apple sigue siendo independiente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les abonnements et les vidéos aimées viennent de votre compte. Connectez-vous avec Google pour charger cet onglet. La bibliothèque de la session Apple reste séparée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सब्सक्रिप्शन और पसंद किए वीडियो आपके खाते से आते हैं। यह टैब लोड करने के लिए Google से साइन इन करें। Apple से साइन-इन की लाइब्रेरी अलग रहती है।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As inscrições e os vídeos curtidos vêm da sua conta. Entre com o Google para carregar esta aba. A biblioteca da sessão com a Apple continua separada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "订阅与赞过的视频来自你的账户。请使用 Google 登录以加载此页。通过 Apple 登录的媒体库账号相互独立。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "訂閱與讚過的影片來自你的帳戶。請使用 Google 登入以載入此頁。透過 Apple 登入的媒體庫帳號彼此獨立。"
          }
        }
      }
    },
