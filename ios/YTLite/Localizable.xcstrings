    "vip.legal_footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم تحصيل الدفع من Apple ID. يتجدد الاشتراك تلقائيًا ما لم يُلغَ قبل 24 ساعة على الأقل من نهاية الفترة. أدِره من إعدادات الحساب."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Payment will be charged to your Apple ID. Subscriptions renew automatically unless canceled at least 24 hours before the end of the period. Manage in Account Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pago se cargará a tu Apple ID. La suscripción se renueva automáticamente salvo que la canceles al menos 24 horas antes del final del periodo. Gestiona en Ajustes de la cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paiement sera débité sur votre identifiant Apple. L’abonnement se renouvelle automatiquement sauf annulation au moins 24 h avant la fin de la période. Gérez dans Réglages du compte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भुगतान आपके Apple ID से लिया जाएगा। अवधि समाप्त होने से कम से कम 24 घंटे पहले रद्द न करने पर सदस्यता अपने आप नवीनीकृत होती है। खाता सेटिंग में प्रबंधित करें।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pagamento será cobrado na sua Apple ID. A assinatura renova automaticamente, a menos que seja cancelada pelo menos 24 horas antes do fim do período. Gerencie em Ajustes da conta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "费用将计入您的 Apple ID。订阅会自动续期，除非在当前周期结束至少 24 小时前取消。可在账户设置中管理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "費用將計入您的 Apple ID。訂閱會自動續期，除非在目前週期結束至少 24 小時前取消。可在帳戶設定中管理。"
          }
        }
      }
    },
