    "feature_intro.playback.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستمر الصوت في الخلفية عند مغادرة التطبيق، ويمكنك الاستماع دون اتصال عند الحاجة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Background audio when you leave the app, plus offline listening when you need it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El audio sigue en segundo plano al salir de la app, y puedes escuchar sin conexión cuando lo necesites."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’audio continue en arrière-plan, et hors ligne quand vous en avez besoin."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप छोड़ने पर ऑडियो जारी रहता है, और ज़रूरत पड़ने पर ऑफ़लाइन भी सुन सकते हैं।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O áudio continua em segundo plano ao sair do app, e você pode ouvir offline quando precisar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切到后台也能继续播，需要时还能离线收听。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切到背景也能繼續播，需要時還能離線收聽。"
          }
        }
      }
    },
