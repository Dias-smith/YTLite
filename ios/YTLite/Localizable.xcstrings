    "settings.shortcuts.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "يعمل عندما يكون Mixtube في المقدمة وأنت لا تكتب. الافتراضي مثل Spotify وQQ Music: المسافة للتشغيل أو الإيقاف، ⌘← للسابق، ⌘→ للتالي، و⌘⇧D للتنزيل." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Works while Mixtube is in front and you are not typing. Defaults match Spotify and QQ Music: Space plays or pauses, Command–Left is previous, Command–Right is next, and Command–Shift–D downloads." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Funciona cuando Mixtube está al frente y no estás escribiendo. Por defecto, como Spotify y QQ Music: Espacio reproduce o pausa, Comando–Izquierda es la anterior, Comando–Derecha es la siguiente y Comando–Mayús–D descarga." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Actif quand Mixtube est au premier plan et que vous ne saisissez pas de texte. Par défaut, comme Spotify et QQ Music : Espace lit ou met en pause, Commande–Gauche est le titre précédent, Commande–Droite le suivant, Commande–Maj–D télécharge." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "तब काम करता है जब Mixtube सामने हो और आप टाइप न कर रहे हों। डिफ़ॉल्ट Spotify और QQ Music जैसा है: स्पेस चलाता या रोकता है, ⌘← पिछला, ⌘→ अगला, और ⌘⇧D डाउनलोड।" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Funciona com o Mixtube na frente e quando você não está digitando. O padrão segue o Spotify e o QQ Music: Espaço reproduz ou pausa, ⌘← é a anterior, ⌘→ é a próxima e ⌘⇧D baixa." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "仅在 Mixtube 位于前台、且没有在输入文字时生效。默认和 Spotify、QQ 音乐一致：空格播放或暂停，⌘← 上一首，⌘→ 下一首，⌘⇧D 下载。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "僅在 Mixtube 位於前景、且沒有在輸入文字時生效。預設與 Spotify、QQ 音樂相同：空白鍵播放或暫停，⌘← 上一首，⌘→ 下一首，⌘⇧D 下載。" } }
      }
    },
