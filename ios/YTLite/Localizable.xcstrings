    "import.mac.guide_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "صل الجهازين بشبكة Wi-Fi نفسها واترك هذه الصفحة مفتوحة. على iPhone افتح الاستيراد واختر الاستلام من Mac، ثم امسح رمز QR أو أدخل العنوان والرمز." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Use the same Wi-Fi and keep this page open. On iPhone, open Import, choose From Mac, then scan the QR code or enter the address and code." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Usa la misma Wi-Fi y deja esta página abierta. En el iPhone, abre Importar, elige Recibir del Mac y escanea el QR o escribe la dirección y el código." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Utilisez le même Wi-Fi et laissez cette page ouverte. Sur l’iPhone, ouvrez Importer, choisissez Recevoir du Mac, puis scannez le QR code ou saisissez l’adresse et le code." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "दोनों डिवाइस एक ही Wi-Fi पर रखें और यह पेज खुला रहने दें। iPhone पर इंपोर्ट खोलें, Mac से प्राप्त करें चुनें, फिर QR स्कैन करें या पता और कोड भरें।" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Use o mesmo Wi-Fi e deixe esta página aberta. No iPhone, abra Importar, escolha Receber do Mac e escaneie o QR ou digite o endereço e o código." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "两台设备连同一个 Wi-Fi，并保持这一页打开。在 iPhone 上打开导入，选择从 Mac 接收，然后扫描二维码，或填写地址和配对码。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "兩台裝置連同一個 Wi-Fi，並保持這一頁打開。在 iPhone 上打開匯入，選擇從 Mac 接收，然後掃描 QR code，或填寫位址和配對碼。" } }
      }
    },
